{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synrail.local/schemas/protected_admission_shadow_v0.schema.json",
  "title": "Synrail Protected Admission Shadow Evaluation v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "mode",
    "evaluation_status",
    "result",
    "merge_blocking",
    "would_block",
    "policy_revision",
    "classifier_scope",
    "diff_semantics",
    "changed_file_count",
    "matched_file_count",
    "reason_codes",
    "matches",
    "detail",
    "evaluation_fingerprint_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "protected_admission_shadow_v0"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "const": "synrail"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mode": {
      "type": "string",
      "const": "SHADOW"
    },
    "evaluation_status": {
      "type": "string",
      "enum": ["COMPLETE", "ERROR"]
    },
    "result": {
      "type": "string",
      "enum": [
        "AUTHORITY_CHANGE_OBSERVED",
        "NO_AUTHORITY_CHANGE_OBSERVED",
        "NOT_EVALUATED"
      ]
    },
    "merge_blocking": {
      "type": "boolean",
      "const": false
    },
    "would_block": {
      "type": "boolean"
    },
    "policy_revision": {
      "type": "string",
      "const": "authority_paths_v0"
    },
    "classifier_scope": {
      "type": "string",
      "const": "PATH_RULES_ONLY"
    },
    "diff_semantics": {
      "type": "string",
      "const": "MERGE_BASE_TO_HEAD_NO_RENAMES"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "merge_base_sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "changed_file_count": {
      "type": "integer",
      "minimum": 0
    },
    "matched_file_count": {
      "type": "integer",
      "minimum": 0
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "AUTHORITY_CHANGE_TESTS",
          "AUTHORITY_CHANGE_CI_WORKFLOW",
          "AUTHORITY_CHANGE_POLICY",
          "AUTHORITY_CHANGE_PERMISSIONS_IAM",
          "AUTHORITY_CHANGE_DEPLOYMENT_GUARDRAIL",
          "NO_AUTHORITY_CHANGE_OBSERVED",
          "ADMISSION_PROJECT_ROOT_INVALID",
          "ADMISSION_GIT_REQUIRED",
          "ADMISSION_GIT_TIMEOUT",
          "ADMISSION_GIT_SAFETY_REJECTED",
          "ADMISSION_BASE_SHA_INVALID",
          "ADMISSION_HEAD_SHA_INVALID",
          "ADMISSION_BASE_COMMIT_UNAVAILABLE",
          "ADMISSION_HEAD_COMMIT_UNAVAILABLE",
          "ADMISSION_MERGE_BASE_UNAVAILABLE",
          "ADMISSION_GIT_DIFF_FAILED",
          "ADMISSION_GIT_OUTPUT_MALFORMED",
          "ADMISSION_PATH_INVALID",
          "ADMISSION_PATH_ENCODING_UNSUPPORTED",
          "ADMISSION_CHANGE_SET_TOO_LARGE",
          "ADMISSION_INTERNAL_ERROR"
        ]
      }
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "change_type",
          "path",
          "categories",
          "reason_codes"
        ],
        "properties": {
          "change_type": {
            "type": "string",
            "enum": ["ADDED", "MODIFIED", "DELETED", "TYPE_CHANGED"]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "categories": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string",
              "enum": [
                "TESTS",
                "CI_WORKFLOW",
                "POLICY",
                "PERMISSIONS_IAM",
                "DEPLOYMENT_GUARDRAIL"
              ]
            }
          },
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string",
              "enum": [
                "AUTHORITY_CHANGE_TESTS",
                "AUTHORITY_CHANGE_CI_WORKFLOW",
                "AUTHORITY_CHANGE_POLICY",
                "AUTHORITY_CHANGE_PERMISSIONS_IAM",
                "AUTHORITY_CHANGE_DEPLOYMENT_GUARDRAIL"
              ]
            }
          }
        }
      }
    },
    "detail": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_fingerprint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
